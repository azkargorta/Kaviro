# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (recomendado; usado por Stripe/redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL pública en producción (referidos, OG; debe coincidir con Supabase Site URL)
NEXT_PUBLIC_SITE_URL=https://www.kaviro.app

# Email transaccional
# - Auth (registro, reset): Supabase → SMTP Resend (sin variable aquí). Ver docs/RESEND_EMAIL_SETUP.md
# - Invitaciones Kaviro Trips, etc.: API Resend en el servidor
RESEND_API_KEY=
# Opcional; por defecto "Kaviro <hola@kaviro.app>"
# RESEND_FROM_EMAIL=Kaviro Trips <hola@kaviro.app>

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@kaviro.app

# E2E Playwright (opcional; test de login autenticado en CI)
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# Centro de ayuda (mailto feedback)
# NEXT_PUBLIC_SUPPORT_EMAIL=soporte@kaviro.app

# Modo «Grupo de gastos» — despliegue gradual (requiere docs/kaviro_trip_mode.sql)
# off = oculto | teaser = enlace secundario (por defecto) | create = selector visible | full = reservado
# NEXT_PUBLIC_EXPENSES_GROUP_MODE=teaser

# Stripe (obligatorio si usas Premium de pago)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de Price en Stripe (crear precio NUEVO si ya hay suscripciones; ver docs/STRIPE_CAMBIAR_PRECIOS.md)
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Kaviro Trips — Agency Pro (B2B)
# Producto Stripe para crear precios mensuales POR AGENCIA (recomendado)
STRIPE_AGENCY_PRODUCT_ID=
# Precio mensual global opcional (legacy; si no hay tarifa por agencia en Ops)
STRIPE_AGENCY_PRICE_ID_MONTHLY=

# Asistente personal / LLM (opcional; necesario para funciones Premium del asistente)
# Provider: "gemini" | "ollama" (y otros si los añades)
AI_PROVIDER=gemini
AI_USER_MONTHLY_BUDGET_EUR=2.00
AI_ENHANCE_ANALYSIS=0

# Gemini (si AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Costes estimados (EUR por millón de tokens) para tracking/presupuesto
GEMINI_FLASH_INPUT_EUR_PER_M_TOKENS=
GEMINI_FLASH_OUTPUT_EUR_PER_M_TOKENS=

# Ollama (si AI_PROVIDER=ollama; normalmente solo local)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# OCR.Space (opcional; usado para análisis de documentos)
OCR_SPACE_API_KEY=

# Admin (opcional; preferido KAVIRO_* — TRIPBOARD_* sigue soportado)
KAVIRO_ADMIN_EMAILS=
# TRIPBOARD_ADMIN_EMAILS=

